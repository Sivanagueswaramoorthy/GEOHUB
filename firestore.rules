rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || isSuperAdmin());
    }

    function isTeamAdmin(teamName) {
      return isAuthenticated() && 
        (isAdmin() || (request.auth.token.role == 'team_admin' && request.auth.token.team == teamName));
    }

    function isDocumentationTeam() {
      return isAuthenticated() && 
        (isAdmin() || request.auth.token.team == 'Documentation');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isVolunteer', 'team']));
      allow delete: if isSuperAdmin();
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Join requests
    match /join_requests/{requestId} {
      allow read: if isAuthenticated() && 
        (isAdmin() || 
         request.auth.uid == resource.data.userId || 
         isTeamAdmin(resource.data.teamId));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isTeamAdmin(resource.data.teamId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Event Registrations
    match /event_registrations/{registrationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isTeamAdmin(request.resource.data.teamId);
      allow update: if isAdmin() || 
                    isTeamAdmin(resource.data.teamId) || 
                    (isAuthenticated() && resource.data.assignedUserIds.hasAny([request.auth.uid]));
      allow delete: if isAdmin() || isTeamAdmin(resource.data.teamId);
    }

    // QR Sessions (writes handled through Cloud Functions)
    match /qr_sessions/{sessionId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated(); // Restrict further in production to Cloud Functions
    }

    // Attendance records (writes handled through Cloud Functions)
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Documents / Gallery metadata
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isDocumentationTeam() || isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
