rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isFaculty() {
      return isAuthenticated() && (getRole() == 'faculty' || getRole() == 'super_admin');
    }

    function isCoordinator() {
      return isAuthenticated() && (getRole() == 'coordinator' || getRole() == 'admin' || isFaculty());
    }

    function isDocumentation() {
      return isAuthenticated() && (getRole() == 'documentation' || isCoordinator());
    }

    function isTreasurer() {
      return isAuthenticated() && (getRole() == 'treasurer' || isFaculty());
    }

    function isPromotion() {
      return isAuthenticated() && (getRole() == 'promotion' || getRole() == 'social_media' || isCoordinator());
    }

    function isTeamAdmin(teamName) {
      return isAuthenticated() && 
        (isCoordinator() || (request.auth.token.post == 'Team Admin' && request.auth.token.team == teamName));
    }

    function isAssignedScanner(eventId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.assignedScannerUserIds;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Protection: Users cannot change their own role, post, status, or team
      allow update: if isFaculty() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'post', 'status', 'isVolunteer', 'team', 'tenureEnd']));
      allow delete: if isFaculty();
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isCoordinator();
    }

    // Join requests
    match /join_requests/{requestId} {
      allow read: if isAuthenticated() && 
        (isCoordinator() || 
         request.auth.uid == resource.data.userId || 
         isTeamAdmin(resource.data.teamId));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isTeamAdmin(resource.data.teamId) || isCoordinator();
      allow delete: if isCoordinator();
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isAuthenticated();
      // Coordinator can create/update drafts, faculty can approve/archive
      allow create: if isCoordinator();
      allow update: if isFaculty() || (
        isCoordinator() && 
        request.resource.data.status != 'approved' && 
        request.resource.data.status != 'archived'
      );
      allow delete: if isFaculty();
    }

    // Event Registrations
    match /event_registrations/{registrationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isCoordinator() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isCoordinator() || isTeamAdmin(request.resource.data.teamId);
      allow update: if isCoordinator() || 
                    isTeamAdmin(resource.data.teamId) || 
                    (isAuthenticated() && resource.data.assignedUserIds.hasAny([request.auth.uid]));
      allow delete: if isCoordinator() || isTeamAdmin(resource.data.teamId);
    }

    // QR Sessions
    match /qr_sessions/{sessionId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isCoordinator());
      allow write: if isFaculty(); // Writes strictly gated to server functions
    }

    // Attendance records: Only assigned scanner or faculty can write
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAssignedScanner(resource.data.eventId);
    }

    // Documents / Gallery metadata
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isDocumentation() || isCoordinator();
      allow delete: if isCoordinator();
    }

    // Audit logs: Faculty read-only
    match /audit_logs/{logId} {
      allow read: if isFaculty();
      allow write: if false; // Cloud Functions only
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
        (resource.data.recipientUserId == request.auth.uid || resource.data.recipientUserId == 'all');
      allow write: if isCoordinator() || isPromotion();
    }
  }
}
